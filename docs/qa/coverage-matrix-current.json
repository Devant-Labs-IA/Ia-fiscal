  "accessibility_checks": [
    {
      "id": "A11Y-LANDMARK-001",
      "execution": "static",
      "requirement": "Exactly one main landmark in the authenticated application shell"
    },
    {
      "id": "A11Y-LANG-001",
      "execution": "static",
      "requirement": "Document language is pt-BR"
    },
    {
      "id": "A11Y-FOCUS-001",
      "execution": "static",
      "requirement": "A global visible focus style exists"
    },
    {
      "id": "A11Y-MOBILE-NAV-001",
      "execution": "static",
      "requirement": "The mobile navigation dialog retains a visible accessible close control"
    },
    {
      "id": "A11Y-KEYBOARD-001",
      "execution": "browser_pending",
      "requirement": "Keyboard order, focus trap, focus return and skip navigation"
    },
    {
      "id": "A11Y-NAME-001",
      "execution": "browser_pending",
      "requirement": "Interactive controls expose names, states and field errors"
    },
    {
      "id": "A11Y-CONTRAST-001",
      "execution": "browser_pending",
      "requirement": "WCAG AA contrast, 200% zoom and responsive reflow"
    }
